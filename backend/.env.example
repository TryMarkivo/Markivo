# ---------------------------------------------------------------------------
# Markivo backend configuration. Copy to `.env` and fill in.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Auth — REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL_DAYS=30

# CORS — comma-separated allowed origins, or * for all (dev only).
# e.g. CORS_ORIGIN=http://localhost:5173,https://app.markivo.uz
CORS_ORIGIN=*

# Database — SQLite file path (default: ./database/markivo.db)
# DB_PATH=./database/markivo.db

# Auth rate limiting
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_MIN=15
