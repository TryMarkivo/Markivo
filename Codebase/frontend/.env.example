# Markivo frontend configuration. Copy to `.env` (or `.env.local`) and adjust.

# Base URL of the Markivo backend API.
# Dev default (if unset): http://localhost:5000
VITE_API_URL=http://localhost:5001

# Subdomain routing (optional). When set, each app section lives on its own
# subdomain of this root domain and navigation crosses origins:
#   <root>         -> landing   (also www.)
#   login.<root>   -> auth (login / register)
#   app.<root>     -> the whole authed app — setup wizard AND dashboard, told
#                     apart by in-app state, not by subdomain
# Leave BLANK to keep the app on a single origin (state-based navigation).
# BAKED IN AT BUILD TIME (Vite inlines it) — a blank value compiles routing out
# entirely, so every subdomain renders the landing view. Rebuild after changing.
# Local testing: set this to `localhost`, then open http://app.localhost:5173
# (browsers resolve any *.localhost name to 127.0.0.1 automatically).
# Production example: trymarkivo.com
VITE_ROOT_DOMAIN=

# Extra hostnames the Vite dev server should accept (comma-separated). `.localhost`
# is always allowed; add a real domain here only when dev-serving under one.
# VITE_DEV_ALLOWED_HOSTS=
