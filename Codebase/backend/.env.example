# ---------------------------------------------------------------------------
# Markivo backend configuration. Copy to `.env` and fill in.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Auth — REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL_DAYS=30

# CORS — comma-separated allowed origins, or * for all (dev only).
# e.g. CORS_ORIGIN=http://localhost:5173,https://app.markivo.uz
CORS_ORIGIN=*

# Database — SQLite file path (default: ./database/markivo.db)
# DB_PATH=./database/markivo.db

# Auth rate limiting
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_MIN=15

# --- AI (Anthropic) ---
# Leave ANTHROPIC_API_KEY blank to run on smart templates (no AI calls).
# Set it to switch content, slogans, and the agent to real Claude generation.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Cheap/fast model for high-volume content; capable model for the agent.
AI_CONTENT_MODEL=claude-haiku-4-5
AI_AGENT_MODEL=claude-opus-4-8
# Capable model for the multi-step marketing pipeline (strategy + critique +
# brand-brief synthesis). Defaults to AI_AGENT_MODEL if unset.
# AI_PIPELINE_MODEL=claude-opus-4-8

# --- Gemini (Google) — second model for grounded research/trends ---
# Leave GEMINI_API_KEY blank to run without it: research falls back to Claude or
# a template, so the app and tests work fully keyless. Set it to let Gemini do
# local-market research / trend / seasonal-hook briefs that feed the strategy
# step. Get a key at https://aistudio.google.com/apikey
# Live mode also needs the SDK: `cd backend && npm i @google/generative-ai`
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- AI (Google Gemini) — social copy + message templates ---
# Leave GEMINI_API_KEY blank and everything still works: post copy falls back to
# Anthropic (then to smart templates), and the message-template feature falls
# back to the built-in heuristic parser, which finds the numbers in a message
# like "Stadium No:141, 9 spots left" without any AI call.
# Set it to make Gemini the primary engine for post copy AND for turning a real
# message into a reusable template with editable variables.
# Get a key at https://aistudio.google.com/apikey (free tier available).
GEMINI_API_KEY=
# Gemini 4 Argon is the reasoning engine for EVERY request: copy, Markiv,
# Autopilot, brand briefs, research, and the art direction that writes the
# image/video render prompts from the owner's own prompt. Argon outputs text
# only — pixels still come from GEMINI_IMAGE_MODEL and VEO_MODEL below. It is
# called through the Interactions API and is PAID-TIER ONLY (no free quota):
# the key's Google Cloud project needs billing enabled. Intro price $2/$10 per
# 1M input/output tokens until 2026-11-30, then $4/$20.
GEMINI_TEXT_MODEL=gemini-4-argon
# Retried once when the primary model refuses a call (no billing, no access,
# quota), so the app keeps answering instead of dropping to templates. Leave
# it set to an empty value to disable the retry.
GEMINI_FALLBACK_MODEL=gemini-flash-latest
# minimal | low | medium | high. Thinking tokens are billed as output and add
# latency; `low` keeps replies well inside the 90s nginx proxy timeout.
GEMINI_THINKING_LEVEL=low
# GEMINI_TIMEOUT_MS=60000

# --- Media generation (same GEMINI_API_KEY as above) ---
# Images render through the Gemini image API, video through Veo. There is no
# separate media key any more. Keyless mode answers 501 "Media engine pending"
# on POST /api/media/:id/render, while briefs, uploads and edit plans keep
# working — rendering has no honest offline fallback, so it degrades loudly.
#
# The lite image model is ~$0.034 per 1K image, about a tenth of the pro tier,
# and the difference does not show at social-post size.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
#
# VIDEO IS THE EXPENSIVE ONE. Veo bills PER SECOND, so both the model and the
# duration below are money dials:
#   veo-3.1-lite-generate-preview  $0.05/s @720p  -> 6s ≈ $0.30, 8s ≈ $0.40
#   veo-3.1-fast-generate-preview  $0.10/s @720p  -> 6s ≈ $0.60
#   veo-3.1-generate-preview       $0.40/s @720p  -> 6s ≈ $2.40
# Duration accepts "4", "6" or "8" only. 1080p and 4k REQUIRE 8s and cost more.
VEO_MODEL=veo-3.1-lite-generate-preview
VEO_DURATION_SECONDS=6
VEO_RESOLUTION=720p
# How long a video job may stay unfinished before the sweep fails it and
# refunds the owner's unit.
# VEO_MAX_WAIT_MS=600000
# MEDIA_TIMEOUT_MS=60000

# WEEKLY generation allowance per tier, split into three buckets that refill
# together at 00:00 UTC each Monday. Split because the costs are not comparable
# — a caption is a fraction of a cent, an image ~$0.03, a video ~$0.30 — and a
# single shared pool would let one account spend a hundred times another's on
# the same nominal "generation".
#
#   writing — copy, agent replies, slogans, brand briefs, template analysis,
#             research, autopilot posts, and every media brief / edit plan
#   image   — full-mode image renders (and applied edits)
#   video   — full-mode video renders. Zero on freemium: it gates the upgrade.
#
# A value of 0 is respected, not treated as unset.
AI_LIMIT_FREEMIUM_WRITING=5
AI_LIMIT_FREEMIUM_IMAGE=2
AI_LIMIT_FREEMIUM_VIDEO=0
AI_LIMIT_PRO_WRITING=15
AI_LIMIT_PRO_IMAGE=10
AI_LIMIT_PRO_VIDEO=4
AI_LIMIT_ULTIMATE_WRITING=40
AI_LIMIT_ULTIMATE_IMAGE=25
AI_LIMIT_ULTIMATE_VIDEO=12

# --- Google Places API (New) — powers the Path A "Discovery" scan ---
# Leave blank to run fully offline with deterministic mock discovery.
# Setup: https://console.cloud.google.com/google/maps-apis
#   1. Create/select a project and enable "Places API (New)"
#      (enabling the classic "Places API" is NOT sufficient).
#   2. Create an API key under Credentials. Use an IP-restricted SERVER key —
#      an HTTP-referrer-restricted key will be rejected for server-side calls.
# Cost: one scan = 2 calls billed at the Enterprise SKU (rating/review fields);
# the free cap (~1k events/month) ≈ 500 free scans. Tune the rate limit below.
GOOGLE_MAPS_API_KEY=
# PLACES_TIMEOUT_MS=8000
SCAN_RATE_LIMIT=10
SCAN_RATE_WINDOW_MIN=15

# --- Billing (Stripe) ---
# Leave STRIPE_SECRET_KEY blank to run in SIMULATED billing mode: plan changes
# apply instantly with no payment, so the upgrade flow stays testable offline.
# Get a TEST-mode key (sk_test_...) at https://dashboard.stripe.com/test/apikeys
# — swap in the live key (sk_live_...) at launch. Payme/Click (UZ) follow
# after merchant onboarding; see CREDENTIALS.local.md.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...). Dashboard → Developers → Webhooks →
# add endpoint https://<api-host>/api/billing/webhook listening for
# checkout.session.completed + customer.subscription.deleted. Locally:
#   stripe listen --forward-to localhost:5000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Frontend origin for checkout success/cancel redirects.
APP_URL=http://localhost:5173
# Monthly subscription prices in USD — provisional until pricing is final.
TIER_PRICE_PRO=20
TIER_PRICE_ULTIMATE=50

# --- Feature flags ---
# Telegram integration (bot connect, channel detection, publish-with-approval,
# live subscriber metric). RE-ENABLED for launch (2026-06-11) — set to false
# to roll back to the coming-soon gate. Bot tokens are entered per business in
# the dashboard UI and stored encrypted (never via env).
TELEGRAM_ENABLED=true

# Scheduled-post worker (publishes due calendar posts every 60s when the
# server runs directly). Set to false to disable the background tick.
# WORKER_ENABLED=true

# Behind a reverse proxy (nginx/Railway/Render) set true so rate limiters key
# on the real client IP.
TRUST_PROXY=false

# --- Instagram (Instagram API with Instagram Login) ---
# Powers the "Connect Instagram" OAuth flow (dashboard pill → Instagram auth
# dialog → callback stores an encrypted long-lived token). Uses the Instagram
# Business Login flow. Credentials are the INSTAGRAM app ID/secret (app dashboard
# → Instagram → API setup with Instagram login) — NOT the Facebook app's. Leave
# BLANK to keep the flow in coming-soon mode (routes answer 503) — the rest of
# the app is unaffected. See CREDENTIALS.local.md for the full setup, including
# the redirect URI you MUST register (it has to match INSTAGRAM_REDIRECT_URI
# byte-for-byte).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Dev default below; production must be an https URL on your API host.
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/instagram/oauth/callback

# --- Meta (Facebook Login) — generic Facebook/Instagram connector ---
# Powers TWO things through one OAuth consent: (1) the "Meta" Facebook + IG
# cards in Settings → Connections (Page/IG Business posting via the generic
# connector — separate from the bespoke Instagram Login flow above), and
# (2) Competitor Intel's Instagram Business Discovery — real competitor post
# content, only available once a business connects Instagram THIS way (not
# via bespoke Instagram Login). Leave blank and both stay in sandbox mode:
# connections simulate, and Instagram competitor fetches fall back to a
# public-page scrape (bio/follower count only, no captions).
# Setup: https://developers.facebook.com/apps -> create/select an app ->
#   add the "Facebook Login" product -> Settings -> Basic for the App ID/Secret.
META_CLIENT_ID=
META_CLIENT_SECRET=

# --- REMOVED: Google OAuth client (Google Business Profile) ---
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are no longer read. They powered
# the Google Business Profile connector, which was removed on 2026-10-19 (no
# more posting to a Business Profile, no "Google profile" chip or Google Maps
# views stat on the dashboard). Delete them from your .env; leaving them set
# does nothing. GOOGLE_MAPS_API_KEY above is a DIFFERENT key and stays: it runs
# the Path A "find my business on Google Maps" discovery scan.

# --- Competitor Intelligence — YouTube Data API v3 ---
# Powers real competitor video stats on YouTube (channel + recent uploads +
# view/like/comment counts). Leave blank and that one fetcher falls back to a
# public channel-page scrape (name + subscriber count only, no video list).
# Instagram/Facebook competitor fetching has no official API either
# way — see backend/competitorFetch.js. Free tier: 10,000 quota units/day,
# plenty for this feature (a channel lookup + video list costs ~5 units).
# Setup: https://console.cloud.google.com/apis/library/youtube.googleapis.com
#   1. Create/select a project and enable "YouTube Data API v3".
#   2. Create an API key under Credentials (a plain API key is enough —
#      no OAuth needed since this only reads PUBLIC channel data).
YOUTUBE_DATA_API_KEY=
# How long a competitor's fetched data is considered fresh before a normal
# page load re-fetches it (minutes). A manual "Refresh" always bypasses this.
COMPETITOR_FETCH_COOLDOWN_MIN=60
