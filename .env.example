# =========================================================================
#             MARKIVO FULL-STACK PLUG-AND-PLAY SERVICES SCHEMA
# =========================================================================
# Copy this file to a new file named '.env' in this same directory, then
# populate the variables below. The server will automatically load these
# and upgrade from sandbox simulations to real, active API connections!
# =========================================================================

# -------------------------------------------------------------------------
# 1. OPENAI API KEY (AI Copywriting, Slogan Generation, & AI Agent Chat)
# -------------------------------------------------------------------------
# - Features: Localized Instagram/Telegram copy generation, dynamic brand guidelines, and intelligent customer agents.
# - Acquire key: https://platform.openai.com/api-keys
# - Pricing: Pay-as-you-go. (GPT-4o-mini is highly recommended for ultra-low costs & fast response times).
OPENAI_API_KEY=your_openai_api_key_here

# -------------------------------------------------------------------------
# 2. TELEGRAM BOT API (Autonomous Channel Scheduled Posting)
# -------------------------------------------------------------------------
# - Features: Natively schedule and publish posts directly to your business Telegram channel when approved.
# - Create a Bot: Open https://t.me/BotFather in Telegram and send '/newbot' to obtain your Token.
# - Get Chat ID: Add your bot as an Administrator to your channel. Your Chat ID is your channel's public handle (e.g. '@my_coffee_channel') or its numeric ID (e.g. '-100293847291').
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=@your_telegram_channel_handle

# -------------------------------------------------------------------------
# 3. GOOGLE PLACES API KEY (Discovery Maps Digital Footprint Crawler)
# -------------------------------------------------------------------------
# - Features: Real Google Maps scanning, ratings extraction, location checks, and business reviews sync.
# - Acquire key: https://console.cloud.google.com/google/maps-apis/overview
# - Steps: Create a GCP Project -> Enable "Places API" -> Generate an API Key under Credentials.
GOOGLE_PLACES_API_KEY=your_google_maps_places_api_key_here
